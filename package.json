{
  "name": "titan-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "api:generate": "openapi-zod-client openapi.json --output src/lib/meeting-bass/schemas.ts",
    "build": "next build",
    "db:generate": "supabase migration new $1",
    "db:migrate": "supabase migration up",
    "db:push": "supabase db push",
    "db:typegen:prod": "supabase gen types --lang=typescript --project-id \"gukeqqpzhaignmhdduma\" --schema public > src/lib/supabase/database.types.ts && tsx scripts/supazod.ts",
    "db:typegen:staging": "supabase gen types --lang=typescript --project-id \"rpdikxvaxfdrrggrfxlv\" --schema public > src/lib/supabase/database.types.ts && tsx scripts/supazod.ts",
    "deploy:trigger": "pnpm dlx trigger.dev@latest deploy --skip-update-check --env staging",
    "deploy:trigger-prod": "pnpm dlx trigger.dev@latest deploy --skip-update-check",
    "dev": "next dev",
    "dev:email": "export $(grep -v '^#' .env.local | xargs) && email dev -p 3001 --dir src/email",
    "format": "prettier --write .",
    "lint": "NODE_ENV=development next lint",
    "recall:generate": "export $(grep -v '^#' .env.local | xargs) && tsx scripts/generate-recall-client.ts",
    "start": "next start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "typecheck": "tsc -w --noEmit"
  },
